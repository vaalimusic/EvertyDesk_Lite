<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Everty.Desktop.Avalonia.MainWindow"
        Width="1440"
        Height="920"
        MinWidth="1240"
        MinHeight="820"
        Title="Everty Studio"
        KeyDown="OnWindowKeyDown">
    <Grid RowDefinitions="Auto,*,Auto,Auto" Background="#0C1016" Margin="20">
        <Border Grid.Row="0" CornerRadius="24" Padding="24" Background="#131922" BorderBrush="#273142" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="8">
                <StackPanel Grid.Column="0" Spacing="8">
                    <TextBlock Text="Everty Studio" FontSize="40" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Avalonia desktop shell. Host/client state and control plane first, WinForms shell gone."
                               FontSize="15"
                               Foreground="#B8C3D5"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="8" HorizontalAlignment="Right">
                    <TextBox Width="420"
                             Text="{Binding ControlPlaneUrl, Mode=TwoWay}"
                             PlaceholderText="Control plane URL"/>
                    <TextBlock Text="{Binding HostStatus}" Foreground="#8BD3FF"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="Advanced" Click="OnToggleAdvancedClick"/>
                        <Button Content="Diagnostics" Click="OnToggleDiagnosticsClick"/>
                        <Button Content="Copy diagnostics" Click="OnCopyDiagnosticsClick"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="0,18,0,18" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <TabItem Header="Host">
                <ScrollViewer>
                    <StackPanel Spacing="16" Margin="0,16,0,16">
                        <Border CornerRadius="20" Padding="20" Background="#11161F" BorderBrush="#263042" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Host runtime" FontSize="24" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding HostDetail}" Foreground="#B8C3D5" TextWrapping="Wrap"/>
                                <Border CornerRadius="14" Padding="12" Background="#0E141D" BorderBrush="#263042" BorderThickness="1">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Connect by code" Foreground="#8B94A5" FontSize="12"/>
                                            <TextBlock Text="{Binding HostCode}" Foreground="White" FontSize="28" FontWeight="Bold" FontFamily="Consolas"/>
                                            <TextBlock Text="Client uses this short code in the Connect by code field." Foreground="#8B94A5" FontSize="12" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="Copy code"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Click="OnCopyHostCodeClick"/>
                                    </Grid>
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Start Host" Click="OnStartHostClick"/>
                                    <Button Content="Stop Host" Click="OnStopHostClick"/>
                                    <Button Content="Refresh Snapshot" Click="OnRefreshHostClick"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Grid ColumnDefinitions="2*,2*,2*" ColumnSpacing="16" IsVisible="{Binding AdvancedVisible}">
                            <Border CornerRadius="20" Padding="18" Background="#11161F" BorderBrush="#263042" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Capture" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                                    <ComboBox ItemsSource="{Binding HostCaptureTargets}" SelectedItem="{Binding CaptureTarget, Mode=TwoWay}"/>
                                    <ComboBox ItemsSource="{Binding HostPresets}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"/>
                                    <Border CornerRadius="14" Padding="12" Background="#0E141D" BorderBrush="#263042" BorderThickness="1">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Selected profile" Foreground="#8B94A5" FontSize="12"/>
                                            <TextBlock Text="{Binding SelectedPresetSummary}" Foreground="#B8C3D5" TextWrapping="Wrap"/>
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="8">
                                                <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding HostProfileWidth, Mode=TwoWay}" PlaceholderText="Width"/>
                                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding HostProfileHeight, Mode=TwoWay}" PlaceholderText="Height"/>
                                                <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding HostProfileFps, Mode=TwoWay}" PlaceholderText="FPS"/>
                                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding HostProfileBitrateMbps, Mode=TwoWay}" PlaceholderText="Mbps"/>
                                            </Grid>
                                            <TextBlock Text="Values are saved separately for Media and Game and used directly when the host starts the sender."
                                                       Foreground="#8B94A5"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <ComboBox ItemsSource="{Binding HostCodecs}" SelectedItem="{Binding SelectedCodec, Mode=TwoWay}"/>
                                    <ComboBox ItemsSource="{Binding HostEncoders}" SelectedItem="{Binding SelectedEncoder, Mode=TwoWay}"/>
                                    <CheckBox IsChecked="{Binding HostAdaptiveStreamingEnabled, Mode=TwoWay}"
                                              Content="Allow adaptive downscale"
                                              Foreground="#B8C3D5"/>
                                    <TextBlock Text="When off, the Windows sender keeps the requested resolution and FPS instead of dropping to smaller adaptive steps."
                                               Foreground="#8B94A5"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" CornerRadius="20" Padding="18" Background="#11161F" BorderBrush="#263042" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Snapshot" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock Text="{Binding HostSnapshot}" Foreground="#B8C3D5" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" CornerRadius="20" Padding="18" Background="#11161F" BorderBrush="#263042" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Route / encoder" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock Text="{Binding HostStatus}" Foreground="#B8C3D5"/>
                                    <TextBlock Text="Auto encoder and route text will appear here when lease arrives." Foreground="#8B94A5" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border CornerRadius="20" Padding="18" Background="#0E141D" BorderBrush="#263042" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Binding PlaybackTitle}" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="{Binding PlaybackDescription}" Foreground="#8B94A5" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Client">
                <ScrollViewer>
                    <StackPanel Spacing="16" Margin="0,16,0,16">
                        <Border CornerRadius="20" Padding="20" Background="#11161F" BorderBrush="#263042" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Client connect" FontSize="24" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding ClientDetail}" Foreground="#B8C3D5" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Demo login" Click="OnDemoLoginClick"/>
                                    <Button Content="Refresh hosts" Click="OnRefreshHostsClick"/>
                                    <Button Content="Restore session" Click="OnRestoreClientClick" IsEnabled="{Binding CanRestoreClientSession}"/>
                                    <Button Content="Connect by code" Click="OnConnectByCodeClick"/>
                                    <Button Content="Stop" Click="OnStopClientClick"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Open player" Click="OnOpenClientPlaybackClick" IsEnabled="{Binding CanOpenClientPlaybackWindow}"/>
                                    <Button Content="Hide player" Click="OnHideClientPlaybackClick" IsEnabled="{Binding IsClientPlaybackWindowVisible}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Grid ColumnDefinitions="2*,2*" ColumnSpacing="16">
                            <Border CornerRadius="20" Padding="18" Background="#11161F" BorderBrush="#263042" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Short code" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBox Text="{Binding SelectedHostCode, Mode=TwoWay}" PlaceholderText="Enter 4-char code"/>
                                    <TextBlock Text="Preset" FontSize="16" Foreground="#B8C3D5"/>
                                    <ComboBox ItemsSource="{Binding ClientPresets}" SelectedItem="{Binding SelectedClientPreset, Mode=TwoWay}"/>
                                    <Border CornerRadius="14" Padding="12" Background="#0E141D" BorderBrush="#263042" BorderThickness="1">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Preset summary" Foreground="#8B94A5" FontSize="12"/>
                                            <TextBlock Text="{Binding ClientPresetSummary}" Foreground="#B8C3D5" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Border CornerRadius="14" Padding="12" Background="#0E141D" BorderBrush="#263042" BorderThickness="1">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Selected host" Foreground="#8B94A5" FontSize="12"/>
                                            <TextBlock Text="{Binding SelectedHostSummary}" Foreground="#B8C3D5" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{Binding ClientStatus}" Foreground="#8BD3FF"/>
                                    <TextBlock Text="{Binding ClientSession}" Foreground="#B8C3D5"/>
                                    <TextBlock Text="{Binding ClientRoute}" Foreground="#B8C3D5"/>
                                    <TextBlock Text="{Binding ClientEndpoint}" Foreground="#B8C3D5"/>
                                    <TextBlock Text="{Binding ClientCodec}" Foreground="#B8C3D5"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" CornerRadius="20" Padding="18" Background="#11161F" BorderBrush="#263042" BorderThickness="1" IsVisible="{Binding AdvancedVisible}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Hosts" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                                    <ListBox ItemsSource="{Binding Hosts}" SelectedItem="{Binding SelectedHost, Mode=TwoWay}" Height="240">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding UiLabel}" Foreground="White"/>
                                                    <TextBlock Text="{Binding Description}" Foreground="#8B94A5" FontSize="12"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border CornerRadius="20" Padding="18" Background="#0E141D" BorderBrush="#263042" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Client snapshot" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="{Binding ClientSnapshot}" Foreground="#B8C3D5" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" CornerRadius="18" Padding="12" Background="#11161F" BorderBrush="#263042" BorderThickness="1"
                IsVisible="{Binding DiagnosticsVisible}">
            <TextBlock Text="{Binding DiagnosticsText}" Foreground="#B8C3D5" TextWrapping="Wrap"/>
        </Border>

        <Border Grid.Row="3" CornerRadius="18" Padding="12" Background="#11161F" BorderBrush="#263042" BorderThickness="1">
            <TextBlock Text="Windows runtime adapters active where supported. Avalonia shell first, legacy WinForms shell removed."
                       Foreground="#8B94A5"/>
        </Border>
    </Grid>
</Window>
