<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Уведомление в шторке, когда активен хост-режим -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android TV: приложение без сенсорного экрана и без leanback-UI —
         не требуем ни то, ни другое, иначе некоторые системы/Play Store
         фильтруют/блокируют установку или показ на ТВ-лаунчерах. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:label="EvertyDesk Lite"
        android:icon="@drawable/edesk_lite_logo"
        android:roundIcon="@drawable/edesk_lite_logo"
        android:banner="@drawable/edesk_lite_logo"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="user"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Запуск на Android TV из лаунчера ТВ -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Служба доступности: Android-хост режим (тачпад). Инжектит жесты
             ввода от подключённого клиента. Оверлей-курсор рисуется через
             TYPE_ACCESSIBILITY_OVERLAY — отдельное разрешение не требуется. -->
        <service
            android:name=".EvertyInputService"
            android:exported="true"
            android:label="EvertyDesk — управление хостом"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
